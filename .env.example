# Required in production. The app returns 503 if either value is missing.
APP_BASIC_AUTH_USERNAME="operator"
APP_BASIC_AUTH_PASSWORD="replace-with-a-long-random-password"

# Server-only xAI credentials. Never prefix these with NEXT_PUBLIC_.
XAI_API_KEY="replace-with-xai-api-key"
XAI_MANAGEMENT_API_KEY="replace-with-xai-management-api-key"
XAI_TEAM_ID="replace-with-xai-team-id"
